{
  "$schema": "https://schemas.genesis.local/design-tokens/v1.json",
  "schemaVersion": "1.0",
  "status": "provisional",
  "purpose": "Provider-neutral Genesis visual tokens; not a frontend runtime or capability source of truth.",
  "color": {
    "canvas": "#0E1317",
    "surface": "#171E23",
    "surfaceRaised": "#20292F",
    "border": "#36444D",
    "text": "#F3F0E8",
    "textMuted": "#A9B4B8",
    "selected": "#62CDE0",
    "observed": "#56B8AC",
    "qualified": "#80C7B4",
    "declared": "#A9B4B8",
    "approvalRequired": "#E0AA55",
    "denied": "#D97B82",
    "unavailable": "#6F7B82",
    "focusRing": "#8FD9E7"
  },
  "stateShape": {
    "unavailable": "dashed-circle",
    "declared": "diamond",
    "observed": "circle",
    "qualified": "pentagon",
    "approvalRequired": "triangle",
    "denied": "octagon"
  },
  "spacePx": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },
  "radiusPx": {
    "control": 8,
    "panel": 12,
    "dialog": 16,
    "pill": 999
  },
  "targetMinPx": {
    "pointer": 32,
    "touch": 44
  },
  "motionMs": {
    "instant": 0,
    "fast": 120,
    "normal": 200,
    "slow": 320
  },
  "motion": {
    "reducedMotionDefaultAvailable": true,
    "essentialStateChangeMustNotDependOnAnimation": true,
    "parallaxMaximumPx": 8
  },
  "typography": {
    "family": "system-ui, Segoe UI, sans-serif",
    "minimumBodyPx": 16,
    "minimumDensePx": 14,
    "minimumLineHeight": 1.4,
    "monospace": "ui-monospace, Cascadia Mono, monospace"
  },
  "contrast": {
    "normalTextMinimum": 4.5,
    "largeTextMinimum": 3.0,
    "nonTextMinimum": 3.0
  }
}
